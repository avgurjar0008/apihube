# ==========================================================
# APIHub Backend Environment Example
# Copy this file to .env and configure your secrets
# ==========================================================

PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Supabase PostgreSQL connection string
# Session Pooler (Recommended):
# postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
DB_SSL=true
DB_MAX_CONNECTIONS=20

# JWT secret for signed session cookies (generate a long random 64-char string)
JWT_SECRET=your_super_secret_random_jwt_key_at_least_32_characters_long
COOKIE_SAME_SITE=lax

# Rate limits
GATEWAY_RATE_LIMIT=60
API_RATE_LIMIT=60

# Upstream provider credentials (Optional)
WEATHER_PROVIDER_KEY=
OPENWEATHER_KEY=
FINNHUB_KEY=
NEWS_PROVIDER_KEY=
AI_PROVIDER_KEY=
ALPHAVANTAGE_KEY=
MAPBOX_ACCESS_TOKEN=
HERE_API_KEY=
OPENCAGE_API_KEY=
